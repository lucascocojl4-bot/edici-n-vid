{
  "name": "edicion-video",
  "version": "1.0.0",
  "private": true,
  "description": "Edición automática de videos con Remotion + ffmpeg",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts Principal out/video.mp4",
    "render:vertical": "remotion render src/index.ts Vertical out/vertical.mp4",
    "still": "remotion still src/index.ts Principal out/miniatura.png",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
